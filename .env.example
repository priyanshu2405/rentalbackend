APP_NAME="Neighbours Rental"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Edmonton
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neighbours_rental
DB_USERNAME=root
DB_PASSWORD=

# API-only app: no DB sessions needed
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Verification / reset codes are e-mailed. "log" writes them to storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@neighboursrental.ca"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Neighbours Rental business settings ----
NR_CURRENCY=CAD
NR_SERVICE_FEE_PERCENT=10
NR_TAX_PERCENT=0
NR_PAYMENT_WINDOW_HOURS=48
NR_PAYOUT_DELAY_DAYS=1
NR_AUTO_APPROVE_LISTINGS=false
NR_VERIFICATION_CODE_TTL_MINUTES=15

# Google Sign-In: the OAuth client ID(s) your Flutter app uses (comma separated)
GOOGLE_CLIENT_IDS=
